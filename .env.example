DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=mysql://root:@127.0.0.1:3306/cargo_db

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# SMS
SMS_PROVIDER=console
SMS_API_KEY=

# Payment
PAYMENT_PROVIDER=sandbox
PAYMENT_SECRET_KEY=

# Maps
LEAFLET_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png

# GPS
GPS_AUTH_SECRET=change-me-gps-secret
GPS_INGESTION_RATE_LIMIT=100

# Storage
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage

# Multi-tenant
MULTI_TENANT_MODE=False
SINGLE_TENANT_MODE=True
